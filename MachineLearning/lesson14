        "## scikit-learn\n",
        "from sklearn.linear_model import LinearRegression\n",
        "\n",
        "X = hours.reshape(-1, 1)\n",
        "Y = energy_usage\n",
        "\n",
        "model = LinearRegression()\n",
        "model.fit(X, Y)\n",
        "\n",
        "print(\"Коэффициент (W): \", model.coef_)\n",
        "print(\"Смещение (b): \", model.intercept_)"
      ],
